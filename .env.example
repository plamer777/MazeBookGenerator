# Скопировать в .env и заполнить своими ключами.
# Все ключи опциональны — без них генерация книг работает,
# но темы и иллюстрации будут браться из локальных fallback-данных.

# OpenAI — генерация темы книги (название, описание, задания, keywords)
OPEN_AI_KEY=

# Hugging Face — fallback-провайдер иллюстраций
HF_TOKEN=

# Replicate — основной провайдер иллюстраций
REPLICATE_API_TOKEN=

# MongoDB — опциональное хранилище использованных тем
# (по умолчанию темы пишутся в output/used_themes.json)
# Требует: pip install "maze-book-generator[mongodb]"
MONGODB_ENABLED=false
MONGODB_URI=mongodb://localhost:27017/
